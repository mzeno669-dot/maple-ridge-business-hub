# No defaults are accepted on Vercel. Set secrets through the hosting dashboard.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
HUB_OWNER_EMAIL=
# Required on Vercel; use a pooled PostgreSQL connection URL.
DATABASE_URL=
# Local development only. Never use a filesystem database on Vercel.
HUB_SQLITE_PATH=.private/hub.db
